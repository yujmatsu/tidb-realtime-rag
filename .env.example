# --- TiDB 接続（TiDB Cloud Zero の curl 応答を転記）---
TIDB_HOST=gatewayXX.us-west-2.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=xxxxxxxx
TIDB_DATABASE=rtdb
# TIDB_SSL_CA=/etc/ssl/certs/ca-certificates.crt  # 未指定ならシステムCAを自動探索

# --- rt_demo.py（Gemini で Before/After 会話を生成）を使う場合のみ ---
# Vertex AI を ADC 認証: gcloud auth application-default login
# GCP_PROJECT=your-project
# GCP_LOCATION=us-central1
# VERTEX_GEN_MODEL=gemini-2.5-flash-lite
# GENAI_TIMEOUT_SEC=60

# 注：商品の埋め込みは rt.py の決定的ハッシュ(64次元・schema_rt.sql の VECTOR(64) と一致)を
#     使うため、鮮度計測・HTAP計測には埋め込みAPIキーは不要です（無料・再現的）。

# --- mem9（任意・コンテスト加点用。ユーザー文脈の長期記憶）---
# ホスト版 https://api.mem9.ai でキー取得、またはセルフホスト(mnemo-server)
# MEM9_API_KEY=...
# MEM9_API_URL=https://api.mem9.ai
# MEM9_AGENT_ID=realtime-rag-demo
